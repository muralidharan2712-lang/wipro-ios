task_2
let sentence = "swift is fun and swift is fast"
let words = sentence.split(separator: " ").map(String.init)
print(words.count)
print(Set(words).sorted())
var freq: [String: Int] = [:]
for w in words { freq[w, default: 0] += 1 }
print(freq)
let ranked = freq.sorted { $0.value != $1.value ? $0.value > $1.value : $0.key < $1.key }
for (word, count) in ranked { print("\(word): \(count)") }

